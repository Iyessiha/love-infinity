# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://prwfomjvhscxosdxeoes.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret serveur pour hacher les adresses IP et les numéros (longue chaîne aléatoire)
HASH_SECRET=

# Cloudflare Turnstile (facultatif en local, obligatoire en production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# URL publique du site (liens de confirmation d'email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=

# GeniusPay (tableau de bord marchand). Clés sandbox pour les tests, live en production.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# Secret du webhook (whsec_…), affiché une seule fois à la création du webhook.
# URL du webhook à déclarer : <SITE>/api/paiement/webhook (événement payment.success, failed, cancelled, expired, refunded)
GENIUSPAY_WEBHOOK_SECRET=
